# Shadow Arrow Environment Configuration Example
# Copy this file to .env and set your actual values locally or in Vercel settings.

ADMIN_USER=admin
ADMIN_PASS=your_admin_password_here
JWT_SECRET=your_jwt_secret_key_here

# Backend Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Frontend Vite Supabase Configuration (accessible in browser via import.meta.env)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
